# Required for AI chat and script explanations
GROQ_API_KEY=gsk_replace_with_your_key

# Required in production for shared scripts and deployment-wide rate limits
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_your_token

# Only for non-Vercel deployments behind a trusted proxy that overwrites X-Forwarded-For
# SUDOSTART_TRUST_PROXY=true
